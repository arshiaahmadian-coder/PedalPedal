        \u06A9\u0647 \u062F\u0631 \u0622\u06CC\u0646\u062F\u0647 \u0628\u0647 \u067E\u0647\u0644\u0648\u0627\u0646\u06CC
        \u0646\u0627\u0645\u062F\u0627\u0631 \u062A\u0628\u062F\u06CC\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F
        \u0648 \u0627\u0632 \u0627\u06CC\u0631\u0627\u0646 \u062F\u0631 \u0628\u0631\u0627\u0628\u0631
