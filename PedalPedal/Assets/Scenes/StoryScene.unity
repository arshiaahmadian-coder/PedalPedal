--- !u!1001 &1080941208
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 21524727}
    m_Modifications:
    - target: {fileID: 1598325758524413089, guid: d4e7ea3abb1a8c542a1e27a0a3aed9aa, type: 3}
      propertyPath: m_Text
      value: "\uFEDE\uFB91\uFEB7 \uFEE9\uFEA9\uFE8D\uFEAA\uFEDF\uFEA9 \uFEED\uFEA9
        \uFEE5\uFE8E\uFBFF\uFEE3 \uFBFC\uFE8D\uFEEA\uFEE7\uFE8E\uFEB4\uFED3\uFE8D
        \uFBFD\uFED8\uFEB8\uFECB \u060C\uFEE5\uFE8D\uFEAE\uFBFE\uFE8D \uFEAD\uFEED\uFE8E\uFEE8\uFEEC\uFB58
        \uFEE6\uFBFF\uFEE3\uFEAF\uFEAE\uFEB3 \uFEAD\uFEA9 \u060C\uFEE6\uFEEC\uFB90
        \uFEE5\uFE8D\uFEAD\uFE8E\uFB94\uFEAF\uFEED\uFEAD \uFEAD\uFEA9\n.\uFEA9\uFE8D\uFEA9
        \uFEAE\uFBFF\uFBFF\uFED0\uFE97 \uFEEA\uFEB8\uFBFF\uFEE4\uFEEB \uFBFC\uFE8D\uFEAE\uFE91
        \uFE8D\uFEAD \uFE8E\uFEEB\uFEE5\uFE81 \uFE96\uFEB7\uFEEE\uFEE7\uFEAE\uFEB3
        \uFEEA\uFB90 \uFBFD\uFED8\uFEB8\uFECB \u061B\uFE96\uFED3\uFEAE\uFB94\n\n\uFEED
        \uFBFD\uFBFE\uFE8E\uFE92\uFBFE\uFEAF \uFED2\uFEBB\uFEED \uFE8E\uFE91 \uFEDE\uFE91\uFE8E\uFB90
        \uFEEA\uFE91 \uFBFC\uFEAE\uFED4\uFEB3 \uFEAD\uFEA9 \u060C\uFEE5\uFE8D\uFEAE\uFBFE\uFE8D
        \uFEAD\uFE8D\uFEAA\uFEE3\uFE8E\uFEE7 \uFEE5\uFE8E\uFEE7\uFE8D\uFEEE\uFEE0\uFEEC\uFB58
        \uFEAF\uFE8D \uFEED \uFEE1\uFE8E\uFEB3 \uFEAA\uFEE7\uFEAF\uFEAE\uFED3 \u060C\uFEDD\uFE8D\uFEAF\n\uFEE5\uFEAA\uFBFF\uFEE8\uFEB7
        \uFE8E\uFE91 \uFEB0\uFBFF\uFEE7 \uFEEA\uFE91\uFE8D\uFEA9\uFEED\uFEAD \u060C\uFEAE\uFB95\uFBFE\uFEA9
        \uFBFC\uFEEE\uFEB3 \uFEAF\uFE8D .\uFEAA\uFEB7 \uFE8E\uFEE8\uFEB7\uFE81 \u060C\uFEE9\uFE8E\uFEB7
        \uFE8F\uFE8D\uFEAE\uFEEC\uFEE3 \uFEAE\uFE98\uFEA7\uFEA9 \u060C\uFEEA\uFE91\uFE8D\uFEA9\uFEED\uFEAD
        \uFBFC\uFEAA\uFEE8\uFEE3\uFEA9\uFEAE\uFEA7\n.\uFE96\uFEB4\uFE91 \uFEED\uFE8D
        \uFEEA\uFE91 \uFEDD\uFEA9 \u060C\uFEDD\uFE8D\uFEAF \uFEB0\uFBFF\uFB95\uFEE7\uFE8D\uFE96\uFED4\uFB95\uFEB7
        \uFBFC\uFE8E\uFEEB\uFBFD\uFB94\uFB8B\uFBFE\uFEED \uFEED \uFE8E\uFEEB\uFBFC\uFEAD\uFEED\uFEFB\uFEA9
        \uFEE5\uFE8E\uFE98\uFEB3\uFE8D\uFEA9\n\n\uFBFC\uFE8E\uFEEB\uFBFD\uFEE8\uFEE4\uFEB7\uFEA9
        \uFEED \uFE8E\uFEEB\uFEE5\uFE8D\uFEAA\uFEE7\uFE8E\uFEA7 \uFE95\uFEED\uFE8E\uFED4\uFE97
        .\uFEA9\uFEEE\uFE91 \uFEED\uFEAD\uFEEA\uFE91\uFEED\uFEAD \uFBFD\uFB94\uFEAD\uFEB0\uFE91
        \uFECA\uFEE7\uFE8D\uFEEE\uFEE3 \uFE8E\uFE91 \uFEE5\uFE8D\uFEEE\uFE9F \uFEED\uFEA9
        \uFEE6\uFBFE\uFE8D \uFED6\uFEB8\uFECB \uFE8E\uFEE3\uFE8D\n\uFE8E\uFE91 \uFEAA\uFEE8\uFE98\uFED3\uFEAE\uFB94
        \uFEE2\uFBFF\uFEE4\uFEBC\uFE97 \uFEEA\uFE91\uFE8D\uFEA9\uFEED\uFEAD \uFEED
        \uFEDD\uFE8D\uFEAF \u060C\uFEDD\uFE8E\uFEA3 \uFEE6\uFBFE\uFE8D \uFE8E\uFE91
        .\uFEA9\uFEAE\uFB90\uFBFD\uFEE3 \uFEAD\uFE8D\uFEEE\uFEB7\uFEA9 \uFE8D\uFEAD
        \uFE8E\uFEEB\uFEE5\uFE81 \uFEDD\uFE8E\uFEBB\uFEED \u060C\uFEEA\uFEE8\uFBFE\uFEAE\uFBFE\uFEA9\n.\uFEAA\uFEE8\uFEE8\uFB90
        \uFEB5\uFEFC\uFE97 \uFEAE\uFB95\uFBFE\uFEAA\uFB91\uFBFE \uFEEA\uFE91 \uFEE5\uFEAA\uFBFF\uFEB3\uFEAD
        \uFBFC\uFE8D\uFEAE\uFE91 \u060C\uFE8E\uFEEB\uFE96\uFED4\uFEDF\uFE8E\uFEA8\uFEE3
        \uFEE1\uFE8E\uFEE4\uFE97 \uFEA9\uFEEE\uFE9F\uFEED\n\n.\uFEAA\uFEE7\uFEA9\uFEAE\uFB90
        \uFE8E\uFED4\uFBFE\uFE8D \uFED6\uFEB8\uFECB \uFEE6\uFBFE\uFE8D \uFBFC\uFEAE\uFBFF\uFB94\uFEDE\uFB91\uFEB7
        \uFEAD\uFEA9 \uFEE2\uFEEC\uFEE3 \uFBFD\uFEB8\uFED8\uFEE7 \uFEEA\uFE91\uFE8D\uFEA9\uFEED\uFEAD
        \uFEAD\uFE8D\uFEA9\uFE8E\uFED3\uFEED \uFEB0\uFBFF\uFEE8\uFB90 \uFEED\uFEA9
        \u060C\uFEE5\uFE8E\uFBFF\uFEE3 \uFEE6\uFBFE\uFE8D \uFEAD\uFEA9\n\uFBFC\uFE8E\uFEEB\uFEE1\uFE8E\uFBFF\uFB58
        \uFEED \uFEAA\uFEE7\uFEAA\uFEB7 \uFEEA\uFE91\uFE8D\uFEA9\uFEED\uFEAD \uFEED
        \uFEDD\uFE8D\uFEAF \uFEE5\uFE8E\uFBFF\uFEE3 \uFEC1\uFE8E\uFE92\uFE97\uFEAD\uFE8D
        \uFEEA\uFEC4\uFEB3\uFE8D\uFEED \u060C\uFE96\uFECB\uFE8E\uFEA0\uFEB7 \uFEED
        \uFBFD\uFB90\uFEAE\uFBFE\uFEAF \uFE8E\uFE91 \uFE8E\uFEEB\uFEE5\uFE81\n.\uFEAA\uFEE7\uFEAA\uFEE7\uFE8E\uFEB3\uFEAD
        \uFEAE\uFB95\uFBFE\uFEAA\uFB91\uFBFE \uFEEA\uFE91 \uFE8D\uFEAD \uFEE9\uFEA9\uFE8D\uFEAA\uFEDF\uFEA9
        \uFEED\uFEA9 \uFEE6\uFBFE\uFE8D \uFEEA\uFEE7\uFE8E\uFED8\uFEB7\uFE8E\uFECB\n\n\uFEED
        \uFEA9\uFEAE\uFBFF\uFB94\uFBFD\uFEE3 \uFEAD\uFE8D\uFEAE\uFED7 \uFEE5\uFE8E\uFEB3\uFEAD\uFEEA\uFEE3\uFE8E\uFEE7
        \uFEB0\uFBFF\uFEE8\uFB90 \uFEED\uFEA9 \uFEE6\uFBFE\uFE8D \uFEB6\uFED8\uFEE7
        \uFEAD\uFEA9 \uFEE6\uFB91\uFBFE\uFEAF\uFE8E\uFE91 \u060C\xAB\uFEEA\uFE91\uFE8D\uFEA9\uFEED\uFEAD
        \uFEED \uFEDD\uFE8D\uFEAF\xBB \uFBFC\uFEAF\uFE8E\uFE91 \uFEAD\uFEA9\n\uFEDE\uFEA3
        \uFEED \uFECA\uFEE7\uFE8D\uFEEE\uFEE3 \uFEE6\uFE98\uFEB7\uFE8D\uFEAC\uFB94
        \uFEAE\uFEB3 \uFE96\uFEB8\uFB58 \u060C\uFEE5\uFEEE\uFB94\uFE8E\uFEE7\uFEEE\uFB94
        \uFBFC\uFE8E\uFEEB\uFEAE\uFBFF\uFEB4\uFEE3 \uFEAF\uFE8D \uFEAD\uFEEE\uFE92\uFECB
        \uFE8E\uFE91 \uFEA9\uFEAD\uFE8D\uFEA9 \uFEEA\uFED4\uFBFF\uFEC7\uFEED\n.\uFEAA\uFEE7\uFE8E\uFEB3\uFEAE\uFE91
        \uFEAA\uFEBC\uFED8\uFEE3 \uFEEA\uFE91 \uFE8D\uFEAD \uFEEA\uFE91\uFE8D\uFEA9\uFEED\uFEAD
        \uFEED \uFEDD\uFE8D\uFEAF \uFBFC\uFE8E\uFEEB\uFEE1\uFE8E\uFBFF\uFB58 \uFEED
        \uFE8E\uFEEB\uFEEA\uFEE3\uFE8E\uFEE7 \u060C\uFED2\uFEE0\uFE98\uFEA8\uFEE3
        \uFBFC\uFE8E\uFEEB\uFEB6\uFEDF\uFE8E\uFB7C\n\n\uFEE6\uFBFE\uFE8D \uFE96\uFEB7\uFEEE\uFEE7\uFEAE\uFEB3
        \uFEED \uFE96\uFEB3\uFE8D \uFEAE\uFB95\uFBFE\uFEAA\uFB91\uFBFE \uFEEA\uFE91
        \uFED6\uFEB7\uFE8E\uFECB \uFEED\uFEA9 \uFEE6\uFBFE\uFE8D \uFEE5\uFEAA\uFEB7
        \uFEAE\uFE97\uFB8F\uFBFE\uFEA9\uFEB0\uFEE7 \uFEAD\uFEA9 \uFBFD\uFEE3\uFE8E\uFB94
        \u060C\uFE96\uFBFE\uFEAD\uFEEE\uFEE3\uFE84\uFEE3 \uFEAE\uFEEB\n.\uFEA9\uFEAD\uFEEE\uFEA7\uFBFD\uFEE3
        \uFEE9\uFEAE\uFB94 \uFEE6\uFB91\uFBFE\uFEAF\uFE8E\uFE91 \uFEB5\uFEEE\uFEEB
        \uFEED \uFE96\uFED7\uFEA9 \u060C\uFEB5\uFEFC\uFE97 \uFEEA\uFE91 \uFBFC\uFE8D\uFEEA\uFEE7\uFE8E\uFEB4\uFED3\uFE8D
        \uFED6\uFEB8\uFECB\n\n\uFBFC\uFEAE\uFBFF\uFB94\uFEDE\uFB91\uFEB7 \uFEAD\uFEA9
        \uFEED \uFEAA\uFBFF\uFEE7\uFE8E\uFEB3\uFEAE\uFE91 \uFE96\uFEE3\uFEFC\uFEB3
        \uFEEA\uFE91 \uFE8D\uFEAD \uFEE9\uFEA9\uFE8D\uFEAA\uFEDF\uFEA9 \uFEED\uFEA9
        \uFEE6\uFBFE\uFE8D \uFBFD\uFEE7\uFE8E\uFEEC\uFEE8\uFB58 \uFBFC\uFE8E\uFEEB\uFEE1\uFE8E\uFBFF\uFB58
        \uFEAA\uFBFF\uFEE7\uFE8D\uFEEE\uFE97\uFBFD\uFEE3 \uFE8E\uFBFE\uFE81\n\u061F\uFEAA\uFBFF\uFEB7\uFE8E\uFE91
        \uFEEA\uFE98\uFEB7\uFE8D\uFEA9 \uFEB6\uFED8\uFEE7 \uFEEA\uFEE3\uFE8E\uFEE8\uFEEB\uFE8E\uFEB7
        \uFEEA\uFEE7\uFE8E\uFED8\uFEB7\uFE8E\uFECB \uFBFC\uFE8E\uFEEB\uFEE5\uFE8E\uFE98\uFEB3\uFE8D\uFEA9
        \uFEE6\uFBFE\uFEAE\uFE97\uFEAD\uFE8E\uFB94\uFEAA\uFEE7\uFE8E\uFEE3 \uFEAF\uFE8D
        \uFBFD\uFB91\uFBFE"
      objectReference: {fileID: 0}
