    - target: {fileID: 3431571982779580195, guid: d4e7ea3abb1a8c542a1e27a0a3aed9aa, type: 3}
      propertyPath: arabicText
      value: "\u062F\u0631 \u0631\u0648\u0632\u06AF\u0627\u0631\u0627\u0646 \u06A9\u0647\u0646\u060C
        \u062F\u0631 \u0633\u0631\u0632\u0645\u06CC\u0646 \u067E\u0647\u0646\u0627\u0648\u0631
        \u0627\u06CC\u0631\u0627\u0646\u060C \u0632\u0645\u0627\u0646\u06CC \u06A9\u0647
        \u067E\u0647\u0644\u0648\u0627\u0646\u0627\u0646 \u0628\u0632\u0631\u06AF
        \u0648 \u067E\u0627\u062F\u0634\u0627\u0647\u0627\u0646 \u0646\u0627\u0645\u062F\u0627\u0631
        \u0633\u0631\u0646\u0648\u0634\u062A \u0645\u0631\u062F\u0645\u0627\u0646
        \u0631\u0627 \u0631\u0642\u0645 \u0645\u06CC\u200C\u0632\u062F\u0646\u062F\u060C
        \u0639\u0634\u0642\u06CC \u0627\u0641\u0633\u0627\u0646\u0647\u200C\u0627\u06CC
        \u0645\u06CC\u0627\u0646 \u062F\u0648 \u062C\u0648\u0627\u0646 \u0634\u06A9\u0644
        \u06AF\u0631\u0641\u062A\u061B \u0639\u0634\u0642\u06CC \u06A9\u0647 \u0628\u0627
        \u0648\u062C\u0648\u062F \u062F\u0634\u0645\u0646\u06CC \u062E\u0627\u0646\u062F\u0627\u0646\u200C\u0647\u0627\u060C
        \u0645\u062E\u0627\u0644\u0641\u062A \u0641\u0631\u0645\u0627\u0646\u0631\u0648\u0627\u06CC\u0627\u0646
        \u0648 \u0645\u0648\u0627\u0646\u0639 \u0641\u0631\u0627\u0648\u0627\u0646\u060C
        \u0633\u0631\u0627\u0646\u062C\u0627\u0645 \u0628\u0647 \u067E\u06CC\u0648\u0646\u062F\u06CC
        \u0645\u0627\u0646\u062F\u06AF\u0627\u0631 \u0627\u0646\u062C\u0627\u0645\u06CC\u062F.
        \u0627\u06CC\u0646 \u062F\u0627\u0633\u062A\u0627\u0646\u060C \u0631\u0648\u0627\u06CC\u062A
        \u0639\u0627\u0634\u0642\u0627\u0646\u0647 \u0632\u0627\u0644 \u0648 \u0631\u0648\u062F\u0627\u0628\u0647\u060C
        \u06CC\u06A9\u06CC \u0627\u0632 \u0632\u06CC\u0628\u0627\u062A\u0631\u06CC\u0646
        \u0648 \u0645\u0634\u0647\u0648\u0631\u062A\u0631\u06CC\u0646 \u062F\u0627\u0633\u062A\u0627\u0646\u200C\u0647\u0627\u06CC
        \u0634\u0627\u0647\u0646\u0627\u0645\u0647 \u062D\u06A9\u06CC\u0645 \u0627\u0628\u0648\u0627\u0644\u0642\u0627\u0633\u0645
        \u0641\u0631\u062F\u0648\u0633\u06CC \u0627\u0633\u062A.\n\n\u0645\u0627\u062C\u0631\u0627\u06CC
        \u062F\u0627\u0633\u062A\u0627\u0646 \u0627\u0632 \u062A\u0648\u0644\u062F
        \u0632\u0627\u0644\u060C \u0641\u0631\u0632\u0646\u062F \u0633\u0627\u0645
        \u0646\u0631\u06CC\u0645\u0627\u0646\u060C \u067E\u0647\u0644\u0648\u0627\u0646
        \u0646\u0627\u0645\u062F\u0627\u0631 \u0627\u06CC\u0631\u0627\u0646\u060C
        \u0622\u063A\u0627\u0632 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0632\u0627\u0644
        \u0647\u0646\u06AF\u0627\u0645 \u062A\u0648\u0644\u062F \u0628\u0631\u062E\u0644\u0627\u0641
        \u062F\u06CC\u06AF\u0631 \u0646\u0648\u0632\u0627\u062F\u0627\u0646\u060C
        \u0645\u0648\u0647\u0627\u06CC\u06CC \u06A9\u0627\u0645\u0644\u0627\u064B
        \u0633\u067E\u06CC\u062F \u062F\u0627\u0634\u062A. \u0633\u0627\u0645 \u06A9\u0647
        \u0627\u0632 \u0638\u0627\u0647\u0631 \u0645\u062A\u0641\u0627\u0648\u062A
        \u0641\u0631\u0632\u0646\u062F\u0634 \u0634\u06AF\u0641\u062A\u200C\u0632\u062F\u0647
        \u0648 \u0634\u0631\u0645\u0633\u0627\u0631 \u0634\u062F\u0647 \u0628\u0648\u062F\u060C
        \u062A\u0635\u0645\u06CC\u0645 \u06AF\u0631\u0641\u062A \u0627\u0648 \u0631\u0627
        \u0627\u0632 \u062E\u0648\u062F \u062F\u0648\u0631 \u06A9\u0646\u062F. \u0628\u0647
        \u0641\u0631\u0645\u0627\u0646 \u0627\u0648\u060C \u0646\u0648\u0632\u0627\u062F
        \u0631\u0627 \u0628\u0647 \u06A9\u0648\u0647 \u0627\u0644\u0628\u0631\u0632
        \u0628\u0631\u062F\u0646\u062F \u0648 \u062F\u0631 \u0622\u0646\u062C\u0627
        \u0631\u0647\u0627 \u06A9\u0631\u062F\u0646\u062F. \u0627\u0645\u0627 \u0633\u0631\u0646\u0648\u0634\u062A
        \u0628\u0631\u0627\u06CC \u0632\u0627\u0644 \u0622\u06CC\u0646\u062F\u0647
        \u062F\u06CC\u06AF\u0631\u06CC \u0631\u0642\u0645 \u0632\u062F\u0647 \u0628\u0648\u062F.\n\n\u0633\u06CC\u0645\u0631\u063A\u060C
        \u067E\u0631\u0646\u062F\u0647\u200C\u0627\u06CC \u0627\u0641\u0633\u0627\u0646\u0647\u200C\u0627\u06CC
        \u0648 \u062E\u0631\u062F\u0645\u0646\u062F \u06A9\u0647 \u0628\u0631 \u0641\u0631\u0627\u0632
        \u06A9\u0648\u0647 \u0627\u0644\u0628\u0631\u0632 \u0632\u0646\u062F\u06AF\u06CC
        \u0645\u06CC\u200C\u06A9\u0631\u062F\u060C \u0646\u0648\u0632\u0627\u062F
        \u0631\u0627 \u06CC\u0627\u0641\u062A \u0648 \u0628\u0647 \u0622\u0634\u06CC\u0627\u0646\u0647
        \u062E\u0648\u062F \u0628\u0631\u062F. \u0627\u0648 \u0632\u0627\u0644 \u0631\u0627
        \u062F\u0631 \u06A9\u0646\u0627\u0631 \u062C\u0648\u062C\u0647\u200C\u0647\u0627\u06CC
        \u062E\u0648\u06CC\u0634 \u067E\u0631\u0648\u0631\u0634 \u062F\u0627\u062F
        \u0648 \u0633\u0627\u0644\u200C\u0647\u0627 \u0627\u0632 \u0627\u0648 \u0645\u0631\u0627\u0642\u0628\u062A
        \u06A9\u0631\u062F. \u0632\u0627\u0644 \u062F\u0631 \u062F\u0627\u0645\u0627\u0646
        \u0633\u06CC\u0645\u0631\u063A \u0628\u0632\u0631\u06AF \u0634\u062F \u0648
        \u0628\u0647 \u062C\u0648\u0627\u0646\u06CC \u0646\u06CC\u0631\u0648\u0645\u0646\u062F
        \u0648 \u062F\u0627\u0646\u0627 \u062A\u0628\u062F\u06CC\u0644 \u06AF\u0631\u062F\u06CC\u062F.
        \u0633\u0627\u0644\u200C\u0647\u0627 \u0628\u0639\u062F\u060C \u0633\u0627\u0645
        \u06A9\u0647 \u0627\u0632 \u0631\u0647\u0627 \u06A9\u0631\u062F\u0646 \u0641\u0631\u0632\u0646\u062F\u0634
        \u0633\u062E\u062A \u067E\u0634\u06CC\u0645\u0627\u0646 \u0634\u062F\u0647
        \u0628\u0648\u062F\u060C \u0628\u0647 \u062C\u0633\u062A\u200C\u0648\u062C\u0648\u06CC
        \u0627\u0648 \u0631\u0641\u062A \u0648 \u0633\u0631\u0627\u0646\u062C\u0627\u0645
        \u062A\u0648\u0627\u0646\u0633\u062A \u0641\u0631\u0632\u0646\u062F\u0634
        \u0631\u0627 \u0628\u0627\u0632\u06CC\u0627\u0628\u062F. \u0633\u06CC\u0645\u0631\u063A
        \u0647\u0646\u06AF\u0627\u0645 \u062C\u062F\u0627\u06CC\u06CC\u060C \u067E\u0631\u06CC
        \u0627\u0632 \u0628\u0627\u0644 \u062E\u0648\u062F \u0628\u0647 \u0632\u0627\u0644
        \u0628\u062E\u0634\u06CC\u062F \u062A\u0627 \u0647\u0631 \u0632\u0645\u0627\u0646
        \u06A9\u0647 \u0628\u0647 \u06A9\u0645\u06A9 \u0646\u06CC\u0627\u0632 \u062F\u0627\u0634\u062A\u060C
        \u0628\u0627 \u0633\u0648\u0632\u0627\u0646\u062F\u0646 \u0622\u0646 \u067E\u0631\u060C
        \u0633\u06CC\u0645\u0631\u063A \u0631\u0627 \u0641\u0631\u0627 \u0628\u062E\u0648\u0627\u0646\u062F.\n\n\u0632\u0627\u0644
        \u067E\u0633 \u0627\u0632 \u0628\u0627\u0632\u06AF\u0634\u062A \u0628\u0647
        \u0646\u0632\u062F \u067E\u062F\u0631\u060C \u062C\u0627\u06CC\u06AF\u0627\u0647
        \u0634\u0627\u06CC\u0633\u062A\u0647 \u062E\u0648\u062F \u0631\u0627 \u062F\u0631
        \u0645\u06CC\u0627\u0646 \u067E\u0647\u0644\u0648\u0627\u0646\u0627\u0646
        \u0627\u06CC\u0631\u0627\u0646 \u0628\u0647 \u062F\u0633\u062A \u0622\u0648\u0631\u062F.
        \u0627\u0648 \u0628\u0627 \u06AF\u0630\u0634\u062A \u0632\u0645\u0627\u0646
