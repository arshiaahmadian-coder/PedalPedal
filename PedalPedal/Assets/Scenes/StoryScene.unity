        \u06A9\u0645\u0646\u062F \u062E\u0648\u062F \u0627\u0633\u062A\u0641\u0627\u062F\u0647
        \u06A9\u0631\u062F \u0648 \u0627\u0632 \u062F\u06CC\u0648\u0627\u0631 \u0628\u0627\u0644\u0627
        \u0631\u0641\u062A.\n\n\u0633\u0631\u0627\u0646\u062C\u0627\u0645 \u062F\u0648
        \u062F\u0644\u062F\u0627\u062F\u0647 \u0628\u0631\u0627\u06CC \u0646\u062E\u0633\u062A\u06CC\u0646
        \u0628\u0627\u0631 \u06CC\u06A9\u062F\u06CC\u06AF\u0631 \u0631\u0627 \u0627\u0632
        \u0646\u0632\u062F\u06CC\u06A9 \u062F\u06CC\u062F\u0646\u062F. \u0622\u0646
        \u0634\u0628\u060C \u0632\u0627\u0644 \u0648 \u0631\u0648\u062F\u0627\u0628\u0647
        \u0633\u0627\u0639\u062A\u200C\u0647\u0627 \u062F\u0631 \u06A9\u0646\u0627\u0631
        \u0647\u0645 \u0646\u0634\u0633\u062A\u0646\u062F \u0648 \u0627\u0632 \u0639\u0634\u0642\u060C
        \u0622\u0631\u0632\u0648\u0647\u0627 \u0648 \u0646\u06AF\u0631\u0627\u0646\u06CC\u200C\u0647\u0627\u06CC\u0634\u0627\u0646
        \u0633\u062E\u0646 \u06AF\u0641\u062A\u0646\u062F. \u0647\u0631 \u062F\u0648
        \u0645\u06CC\u200C\u062F\u0627\u0646\u0633\u062A\u0646\u062F \u06A9\u0647
        \u062E\u0627\u0646\u0648\u0627\u062F\u0647\u200C\u0647\u0627 \u0648 \u0628\u0632\u0631\u06AF\u0627\u0646
        \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0628\u0627 \u067E\u06CC\u0648\u0646\u062F\u0634\u0627\u0646
        \u0645\u062E\u0627\u0644\u0641\u062A \u06A9\u0646\u0646\u062F\u060C \u0627\u0645\u0627
        \u062A\u0635\u0645\u06CC\u0645 \u06AF\u0631\u0641\u062A\u0646\u062F \u062F\u0631
        \u0628\u0631\u0627\u0628\u0631 \u062F\u0634\u0648\u0627\u0631\u06CC\u200C\u0647\u0627
