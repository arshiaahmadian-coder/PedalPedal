        \u0631\u0633\u06CC\u062F\u061B \u062C\u0627\u06CC\u06CC \u06A9\u0647 \u0645\u0647\u0631\u0627\u0628
        \u0634\u0627\u0647 \u0628\u0631 \u0622\u0646 \u0641\u0631\u0645\u0627\u0646\u0631\u0648\u0627\u06CC\u06CC
        \u0645\u06CC\u200C\u06A9\u0631\u062F. \u0645\u0647\u0631\u0627\u0628 \u062F\u062E\u062A\u0631\u06CC
        \u0628\u0647 \u0646\u0627\u0645 \u0631\u0648\u062F\u0627\u0628\u0647 \u062F\u0627\u0634\u062A\u061B
        \u0634\u0627\u0647\u0632\u0627\u062F\u0647\u200C\u0627\u06CC \u0632\u06CC\u0628\u0627\u0631\u0648\u060C
        \u062E\u0631\u062F\u0645\u0646\u062F \u0648 \u0628\u0644\u0646\u062F\u0645\u0631\u062A\u0628\u0647
        \u06A9\u0647 \u0622\u0648\u0627\u0632\u0647 \u0632\u06CC\u0628\u0627\u06CC\u06CC
