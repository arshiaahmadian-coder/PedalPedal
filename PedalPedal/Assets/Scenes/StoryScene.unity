        \u06CC\u06A9\u062F\u06CC\u06AF\u0631 \u062A\u0644\u0627\u0634 \u06A9\u0646\u0646\u062F.
        \u0622\u0646\u200C\u0647\u0627 \u067E\u06CC\u0645\u0627\u0646 \u0628\u0633\u062A\u0646\u062F
        \u06A9\u0647 \u0628\u0647 \u0639\u0634\u0642 \u062E\u0648\u062F \u0648\u0641\u0627\u062F\u0627\u0631
        \u0628\u0645\u0627\u0646\u0646\u062F \u0648 \u0631\u0627\u0647\u06CC \u0628\u0631\u0627\u06CC
        \u0627\u0632\u062F\u0648\u0627\u062C \u067E\u06CC\u062F\u0627 \u06A9\u0646\u0646\u062F.\n\n\u067E\u0633
        \u0627\u0632 \u0627\u06CC\u0646 \u062F\u06CC\u062F\u0627\u0631\u060C \u0632\u0627\u0644
        \u062A\u0635\u0645\u06CC\u0645 \u06AF\u0631\u0641\u062A \u0645\u0648\u0636\u0648\u0639
        \u0631\u0627 \u0628\u0627 \u067E\u062F\u0631\u0634 \u062F\u0631 \u0645\u06CC\u0627\u0646
        \u0628\u06AF\u0630\u0627\u0631\u062F. \u0627\u0648 \u0646\u0627\u0645\u0647\u200C\u0627\u06CC
        \u0628\u0631\u0627\u06CC \u0633\u0627\u0645 \u0646\u0648\u0634\u062A \u0648
        \u062F\u0631 \u0622\u0646 \u0627\u0632 \u0639\u0644\u0627\u0642\u0647 \u0639\u0645\u06CC\u0642
        \u062E\u0648\u062F \u0628\u0647 \u0631\u0648\u062F\u0627\u0628\u0647 \u0633\u062E\u0646
        \u06AF\u0641\u062A. \u0632\u0627\u0644 \u0627\u0632 \u067E\u062F\u0631\u0634
        \u062E\u0648\u0627\u0633\u062A \u06A9\u0647 \u0628\u0627 \u0627\u06CC\u0646
        \u0627\u0632\u062F\u0648\u0627\u062C \u0645\u0648\u0627\u0641\u0642\u062A
        \u06A9\u0646\u062F \u0648 \u0628\u0647 \u0627\u0648 \u0627\u062C\u0627\u0632\u0647
        \u062F\u0647\u062F \u0628\u0627 \u062F\u062E\u062A\u0631 \u0645\u0647\u0631\u0627\u0628
        \u0634\u0627\u0647 \u067E\u06CC\u0648\u0646\u062F \u0628\u0628\u0646\u062F\u062F.\n\n\u0627\u0645\u0627
        \u0633\u0627\u0645 \u067E\u0633 \u0627\u0632 \u062E\u0648\u0627\u0646\u062F\u0646
        \u0646\u0627\u0645\u0647\u060C \u0633\u062E\u062A \u0646\u06AF\u0631\u0627\u0646
        \u0634\u062F. \u0627\u0648 \u0627\u0632 \u06CC\u06A9 \u0633\u0648 \u0641\u0631\u0632\u0646\u062F\u0634
        \u0631\u0627 \u062F\u0648\u0633\u062A \u062F\u0627\u0634\u062A \u0648 \u0645\u06CC\u200C\u062E\u0648\u0627\u0633\u062A
        \u0622\u0631\u0632\u0648\u06CC \u0627\u0648 \u0631\u0627 \u0628\u0631\u0622\u0648\u0631\u062F\u0647
        \u06A9\u0646\u062F\u060C \u0627\u0645\u0627 \u0627\u0632 \u0633\u0648\u06CC
        \u062F\u06CC\u06AF\u0631 \u0645\u06CC\u200C\u062F\u0627\u0646\u0633\u062A
        \u06A9\u0647 \u0631\u0648\u062F\u0627\u0628\u0647 \u0627\u0632 \u0646\u0633\u0644
        \u0636\u062D\u0627\u06A9 \u0627\u0633\u062A \u0648 \u0686\u0646\u06CC\u0646
        \u067E\u06CC\u0648\u0646\u062F\u06CC \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A
        \u062E\u0634\u0645 \u0645\u0646\u0648\u0686\u0647\u0631\u060C \u067E\u0627\u062F\u0634\u0627\u0647
        \u0627\u06CC\u0631\u0627\u0646\u060C \u0631\u0627 \u0628\u0631\u0627\u0646\u06AF\u06CC\u0632\u062F.
        \u0633\u0627\u0645 \u0628\u0631\u0627\u06CC \u06CC\u0627\u0641\u062A\u0646
        \u0631\u0627\u0647\u200C\u062D\u0644 \u0628\u0627 \u0645\u0648\u0628\u062F\u0627\u0646
        \u0648 \u062E\u0631\u062F\u0645\u0646\u062F\u0627\u0646 \u0645\u0634\u0648\u0631\u062A
        \u06A9\u0631\u062F. \u0622\u0646\u0627\u0646 \u0628\u0627 \u0628\u0631\u0631\u0633\u06CC
        \u0633\u0631\u0646\u0648\u0634\u062A \u0627\u06CC\u0646 \u067E\u06CC\u0648\u0646\u062F\u060C
        \u062E\u0628\u0631 \u062F\u0627\u062F\u0646\u062F \u06A9\u0647 \u0627\u0632
        \u0627\u0632\u062F\u0648\u0627\u062C \u0632\u0627\u0644 \u0648 \u0631\u0648\u062F\u0627\u0628\u0647
        \u0641\u0631\u0632\u0646\u062F\u06CC \u0628\u0632\u0631\u06AF \u0648 \u0646\u06CC\u0631\u0648\u0645\u0646\u062F
