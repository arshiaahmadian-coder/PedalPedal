        \u0632\u0627\u0644 \u0628\u0627 \u06AF\u0631\u0641\u062A\u0646 \u0622\u0646\u200C\u0647\u0627
        \u0628\u0647 \u0628\u0627\u0644\u0627\u06CC \u06A9\u0627\u062E \u0628\u0631\u0648\u062F.
        \u0627\u0645\u0627 \u0632\u0627\u0644 \u06A9\u0647 \u0646\u0645\u06CC\u200C\u062E\u0648\u0627\u0633\u062A
        \u0628\u0647 \u06AF\u06CC\u0633\u0648\u0627\u0646 \u0645\u062D\u0628\u0648\u0628\u0634
