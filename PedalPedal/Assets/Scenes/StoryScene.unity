        \u067E\u06CC \u0628\u0631\u062F\u0647 \u0628\u0648\u062F\u060C \u0641\u0631\u0645\u0627\u0646\u0631\u0648\u0627\u06CC\u06CC
        \u0632\u0627\u0628\u0644\u0633\u062A\u0627\u0646 \u0631\u0627 \u0628\u0647
        \u0627\u0648 \u0633\u067E\u0631\u062F.\n\n\u0631\u0648\u0632\u06CC \u0632\u0627\u0644
