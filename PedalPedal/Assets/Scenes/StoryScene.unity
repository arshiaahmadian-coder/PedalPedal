        \u062F\u0631 \u0627\u06CC\u0646 \u0628\u0627\u0632\u06CC\u060C \u0628\u0627\u0632\u06CC\u06A9\u0646
        \u0646\u0642\u0634 \u0646\u0627\u0645\u0647\u200C\u0631\u0633\u0627\u0646
        \u0645\u06CC\u0627\u0646 \u0632\u0627\u0644 \u0648 \u0631\u0648\u062F\u0627\u0628\u0647
        \u0631\u0627 \u0628\u0631 \u0639\u0647\u062F\u0647 \u062F\u0627\u0631\u062F\u061B
        \u0634\u062E\u0635\u06CC\u062A\u06CC \u06A9\u0647 \u0648\u0638\u06CC\u0641\u0647
        \u062F\u0627\u0631\u062F \u067E\u06CC\u0627\u0645\u200C\u0647\u0627 \u0648
        \u0646\u0627\u0645\u0647\u200C\u0647\u0627\u06CC \u0627\u06CC\u0646 \u062F\u0648
        \u062F\u0644\u062F\u0627\u062F\u0647 \u0631\u0627 \u0628\u0647 \u06CC\u06A9\u062F\u06CC\u06AF\u0631
        \u0628\u0631\u0633\u0627\u0646\u062F \u0648 \u0628\u0647 \u0622\u0646\u200C\u0647\u0627
        \u06A9\u0645\u06A9 \u06A9\u0646\u062F \u062A\u0627 \u0628\u0627 \u0648\u062C\u0648\u062F
        \u0641\u0627\u0635\u0644\u0647\u200C\u0647\u0627\u060C \u0645\u0648\u0627\u0646\u0639
        \u0648 \u0645\u062E\u0627\u0644\u0641\u062A\u200C\u0647\u0627\u060C \u0627\u0631\u062A\u0628\u0627\u0637
        \u062E\u0648\u062F \u0631\u0627 \u062D\u0641\u0638 \u06A9\u0646\u0646\u062F.\n\n\u0628\u0627\u0632\u06CC\u06A9\u0646
        \u062F\u0631 \u0637\u0648\u0644 \u0628\u0627\u0632\u06CC \u0628\u0627 \u0627\u0646\u062C\u0627\u0645
        \u0645\u0623\u0645\u0648\u0631\u06CC\u062A\u200C\u0647\u0627\u06CC \u0645\u062E\u062A\u0644\u0641\u060C
        \u0639\u0628\u0648\u0631 \u0627\u0632 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC
        \u06AF\u0648\u0646\u0627\u06AF\u0648\u0646 \u0648 \u067E\u0634\u062A \u0633\u0631
        \u06AF\u0630\u0627\u0634\u062A\u0646 \u0686\u0627\u0644\u0634\u200C\u0647\u0627\u06CC
        \u0645\u062A\u0646\u0648\u0639\u060C \u0628\u0647 \u067E\u06CC\u0634\u0631\u0641\u062A
        \u062F\u0627\u0633\u062A\u0627\u0646 \u06A9\u0645\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u062F.
        \u0647\u0631 \u0646\u0627\u0645\u0647\u200C\u0627\u06CC \u06A9\u0647 \u0628\u0647
        \u0645\u0642\u0635\u062F \u0645\u06CC\u200C\u0631\u0633\u062F\u060C \u06AF\u0627\u0645\u06CC
        \u062F\u0631 \u0646\u0632\u062F\u06CC\u06A9\u200C\u062A\u0631 \u0634\u062F\u0646
        \u0632\u0627\u0644 \u0648 \u0631\u0648\u062F\u0627\u0628\u0647 \u0628\u0647
        \u06CC\u06A9\u062F\u06CC\u06AF\u0631 \u0627\u0633\u062A. \u062F\u0631 \u062C\u0647\u0627\u0646\u06CC
        \u06A9\u0647 \u0622\u0634\u06A9\u0627\u0631 \u0634\u062F\u0646 \u06CC\u06A9
        \u0631\u0627\u0632 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0633\u0631\u0646\u0648\u0634\u062A
        \u062F\u0648 \u062E\u0627\u0646\u062F\u0627\u0646 \u0631\u0627 \u062A\u063A\u06CC\u06CC\u0631
        \u062F\u0647\u062F\u060C \u0648\u0638\u06CC\u0641\u0647 \u0646\u0627\u0645\u0647\u200C\u0631\u0633\u0627\u0646
        \u0627\u0647\u0645\u06CC\u062A \u0648\u06CC\u0698\u0647\u200C\u0627\u06CC
        \u067E\u06CC\u062F\u0627 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0628\u0627\u0632\u06CC\u06A9\u0646
        \u0628\u0627 \u067E\u06CC\u0634\u0631\u0648\u06CC \u062F\u0631 \u0628\u0627\u0632\u06CC\u060C
        \u0628\u0647\u200C\u062A\u062F\u0631\u06CC\u062C \u0628\u0627 \u0634\u062E\u0635\u06CC\u062A\u200C\u0647\u0627\u060C
        \u0627\u062D\u0633\u0627\u0633\u0627\u062A \u0648 \u0627\u062A\u0641\u0627\u0642\u0627\u062A
        \u062F\u0627\u0633\u062A\u0627\u0646 \u0622\u0634\u0646\u0627 \u0645\u06CC\u200C\u0634\u0648\u062F
        \u0648 \u0627\u0632 \u0646\u0632\u062F\u06CC\u06A9 \u062F\u0631 \u062C\u0631\u06CC\u0627\u0646
        \u0634\u06A9\u0644\u200C\u06AF\u06CC\u0631\u06CC \u0627\u06CC\u0646 \u0639\u0634\u0642
        \u0627\u0641\u0633\u0627\u0646\u0647\u200C\u0627\u06CC \u0642\u0631\u0627\u0631
        \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F.\n\n\u067E\u0633 \u0627\u0632
        \u0622\u0646\u06A9\u0647 \u067E\u06CC\u0627\u0645\u200C\u0647\u0627\u06CC
        \u0627\u0648\u0644\u06CC\u0647 \u0645\u06CC\u0627\u0646 \u0632\u0627\u0644
        \u0648 \u0631\u0648\u062F\u0627\u0628\u0647 \u0631\u062F\u0648\u0628\u062F\u0644
        \u0634\u062F\u060C \u0639\u0644\u0627\u0642\u0647 \u0622\u0646\u200C\u0647\u0627
        \u0628\u0647 \u06CC\u06A9\u062F\u06CC\u06AF\u0631 \u0628\u06CC\u0634\u062A\u0631
        \u0634\u062F \u0648 \u0633\u0631\u0627\u0646\u062C\u0627\u0645 \u062A\u0635\u0645\u06CC\u0645
        \u06AF\u0631\u0641\u062A\u0646\u062F \u0645\u062E\u0641\u06CC\u0627\u0646\u0647
        \u0645\u0644\u0627\u0642\u0627\u062A \u06A9\u0646\u0646\u062F. \u0631\u0648\u062F\u0627\u0628\u0647
        \u0645\u0642\u062F\u0645\u0627\u062A \u0627\u06CC\u0646 \u062F\u06CC\u062F\u0627\u0631
        \u0631\u0627 \u062F\u0631 \u06A9\u0627\u062E \u062E\u0648\u062F \u0641\u0631\u0627\u0647\u0645
        \u06A9\u0631\u062F \u0648 \u0632\u0627\u0644 \u0646\u06CC\u0632 \u062F\u0631
        \u0634\u0628\u06CC \u062A\u0627\u0631\u06CC\u06A9\u060C \u062F\u0648\u0631
        \u0627\u0632 \u0686\u0634\u0645 \u062F\u06CC\u06AF\u0631\u0627\u0646\u060C
        \u0628\u0647 \u0633\u0648\u06CC \u06A9\u0627\u062E \u0627\u0648 \u0631\u0641\u062A.\n\n\u0647\u0646\u06AF\u0627\u0645\u06CC
        \u06A9\u0647 \u0632\u0627\u0644 \u0628\u0647 \u067E\u0627\u06CC \u062F\u06CC\u0648\u0627\u0631
