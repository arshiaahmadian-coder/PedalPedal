        \u06A9\u0631\u062F \u0631\u0648\u0632\u06CC \u0627\u06CC\u0646 \u0634\u0627\u0647\u0632\u0627\u062F\u0647
        \u0631\u0627 \u0627\u0632 \u0646\u0632\u062F\u06CC\u06A9 \u0628\u0628\u06CC\u0646\u062F.\n\n\u0627\u0632
