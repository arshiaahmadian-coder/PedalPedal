  dialogCharacterList:
  - {fileID: -4189723386395133421, guid: 73b1d73b5d066b84c8ecd4f5f48f70fe, type: 3}
  dialogTextList:
  - "\u062F\u0631\u0648\u062F \u0628\u0631 \u062A\u0648! \u0645\u0646 \u0631\u0648\u062F\u0627\u0628\u0647\u060C
    \u062F\u062E\u062A\u0631 \u0645\u0647\u0631\u0627\u0628\u060C \u0641\u0631\u0645\u0627\u0646\u0631\u0648\u0627\u06CC
    \u06A9\u0627\u0628\u0644 \u0647\u0633\u062A\u0645."
  - "\u0622\u0647... \u06A9\u0627\u0634 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u0633\u062A\u0645
    \u0631\u0648\u0632\u06CC \u0632\u0627\u0644 \u0631\u0627 \u0627\u0632 \u0646\u0632\u062F\u06CC\u06A9
    \u0628\u0628\u06CC\u0646\u0645!"
  - "\u0622\u0648\u0627\u0632\u0647 \u062F\u0644\u0627\u0648\u0631\u06CC \u0648 \u0645\u0647\u0631\u0628\u0627\u0646\u06CC
    \u0627\u0648 \u0628\u0647 \u06AF\u0648\u0634\u0645 \u0631\u0633\u06CC\u062F\u0647
    \u0648 \u062F\u0644\u0645 \u0631\u0627 \u0634\u06CC\u0641\u062A\u0647\u200C\u0627\u0634
    \u06A9\u0631\u062F\u0647 \u0627\u0633\u062A"
  - "\u0627\u0645\u0627 \u062E\u0627\u0646\u062F\u0627\u0646 \u0645\u0627 \u0628\u0627
    \u06CC\u06A9\u062F\u06CC\u06AF\u0631 \u062F\u0634\u0645\u0646\u06CC \u062F\u06CC\u0631\u06CC\u0646\u0647
    \u062F\u0627\u0631\u0646\u062F \u0648 \u062F\u06CC\u062F\u0627\u0631\u0645\u0627\u0646
    \u0622\u0633\u0627\u0646 \u0646\u06CC\u0633\u062A"
  - "\u0628\u0631\u0627\u06CC \u0647\u0645\u06CC\u0646 \u0646\u0627\u0645\u0647\u200C\u0627\u06CC
    \u0646\u0648\u0634\u062A\u0647\u200C\u0627\u0645 \u062A\u0627 \u0632\u0627\u0644
    \u0627\u0632 \u0627\u062D\u0633\u0627\u0633 \u0645\u0646 \u0628\u0627\u062E\u0628\u0631
    \u0634\u0648\u062F"
  - "\u062A\u0648 \u0628\u0627\u06CC\u062F \u0627\u06CC\u0646 \u0646\u0627\u0645\u0647
    \u0631\u0627 \u0628\u0647 \u0632\u0627\u0644 \u0628\u0631\u0633\u0627\u0646\u06CC!"
  - "\u0627\u0648 \u0622\u0646 \u0633\u0648\u06CC \u0631\u0648\u062F\u062E\u0627\u0646\u0647\u060C
    \u0628\u0627\u0644\u0627\u062A\u0631 \u0627\u0632 \u0645\u0633\u06CC\u0631 \u0631\u0648\u062F\u060C
    \u0645\u0646\u062A\u0638\u0631 \u062E\u0628\u0631 \u0645\u0646 \u0627\u0633\u062A"
  - "\u0645\u0631\u0627\u0642\u0628 \u0628\u0627\u0634 \u0628\u0647 \u0635\u062E\u0631\u0647\u200C\u0647\u0627\u06CC
    \u0631\u0648\u062F\u062E\u0627\u0646\u0647 \u0628\u0631\u062E\u0648\u0631\u062F
    \u0646\u06A9\u0646\u06CC!"
  - "\u0628\u0631\u0648 \u062F\u0648\u0633\u062A \u0645\u0646! \u062F\u0644 \u0645\u0646
    \u0647\u0645\u0631\u0627\u0647 \u062A\u0648\u0633\u062A"
